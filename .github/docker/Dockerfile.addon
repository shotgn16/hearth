# Ready-made Home Assistant add-on image (amd64 + aarch64), built by .github/workflows/addon-image.yml.
# Dependencies are pure JavaScript, so they're installed once on the build machine's own platform (no slow
# emulation) and copied onto the Node.js runtime image for each target architecture.
FROM --platform=$BUILDPLATFORM node:22-alpine AS deps
WORKDIR /app
COPY hearth/package.json hearth/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM node:22-alpine
ARG VERSION=0.0.0
ARG BUILD_ARCH
LABEL io.hass.name="Hearth" io.hass.version="$VERSION" io.hass.type="addon" io.hass.arch="$BUILD_ARCH" \
      org.opencontainers.image.source="https://github.com/shotgn16/hearth" \
      org.opencontainers.image.description="Hearth household money manager — Home Assistant add-on" \
      org.opencontainers.image.licenses="MIT"
RUN apk add --no-cache tzdata wget
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY hearth/package.json ./
COPY hearth/server ./server
COPY hearth/public ./public
COPY hearth/scripts ./scripts
ENV NODE_ENV=production DATA_DIR=/data PORT=8484 TZ=Europe/London HEARTH_VERSION=$VERSION
VOLUME /data
EXPOSE 8484
HEALTHCHECK --interval=60s --timeout=5s CMD wget -qO- http://127.0.0.1:8484/api/status || exit 1
CMD ["node", "server/index.js"]
