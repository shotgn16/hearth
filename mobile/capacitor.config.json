{
  "appId": "com.shotgn16.hearth",
  "appName": "Hearth",
  "webDir": "www",
  "backgroundColor": "#1f2e28",
  "appendUserAgent": "HearthApp/1.6.0",
  "server": {
    "androidScheme": "http",
    "cleartext": true,
    "allowNavigation": ["*"]
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": { "launchAutoHide": true }
  }
}
